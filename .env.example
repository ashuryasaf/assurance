# Copy this file to .env (and .env.production) and fill in real values.

# SQLite database URL. The file lives in ./data/app.db by default.
DATABASE_URL="file:../data/app.db"

# 32+ byte secret used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-32-byte-random-string-please-rotate"

# Demo seed credentials (can stay defaults in dev).
SEED_DEMO_PASSWORD="Demo1234!"

# Set to 1 to disable automatic seeding on first boot.
SKIP_SEED=""
