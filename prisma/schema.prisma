// Real persistent backend for the Assurance / Ashuri Insurance Agency Portal.
// Replaces the previous in-memory mock data with SQL-backed entities.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
// Auth & people
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String
  idNumber        String
  role            String
  permissions     String
  avatar          String?
  agencyId        String?
  parentAgentId   String?
  licenseNumber   String?
  specializations String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastLogin       DateTime?

  agency           Agency?      @relation("UserAgency", fields: [agencyId], references: [id])
  parentAgent      User?        @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  subAgents        User[]       @relation("AgentHierarchy")
  ownedAgencies    Agency[]     @relation("AgencyOwner")
  policiesAsClient Policy[]     @relation("ClientPolicies")
  policiesAsAgent  Policy[]     @relation("AgentPolicies")
  documents        Document[]   @relation("ClientDocuments")
  uploadedDocs     Document[]   @relation("UploaderDocuments")
  reports          Report[]
  bankConnections  BankConnection[]
  portfolio        InvestmentPortfolio?
  recordings       Recording[]
  conversations    AIConversation[]
  affiliates       Affiliate[]
  regulatoryRpts   RegulatoryReport[]
  invitesIssued    InviteToken[] @relation("InviteIssuer")

  @@index([role])
  @@index([agencyId])
}

model InviteToken {
  id            String    @id @default(cuid())
  token         String    @unique
  email         String?
  role          String    @default("client")
  agencyId      String?
  parentAgentId String?
  issuedById    String?
  issuedBy      User?     @relation("InviteIssuer", fields: [issuedById], references: [id])
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model Agency {
  id               String   @id @default(cuid())
  name             String
  licenseNumber    String   @unique
  parentAgencyId   String?
  parent           Agency?  @relation("AgencyHierarchy", fields: [parentAgencyId], references: [id])
  subAgencies      Agency[] @relation("AgencyHierarchy")
  ownerId          String
  owner            User     @relation("AgencyOwner", fields: [ownerId], references: [id])
  address          String
  phone            String
  email            String
  logo             String?
  isActive         Boolean  @default(true)
  regulatoryStatus String   @default("active")
  createdAt        DateTime @default(now())
  agents           User[]   @relation("UserAgency")
}

// -----------------------------------------------------------------------------
// Insurance / financial entities
// -----------------------------------------------------------------------------

model Policy {
  id                String   @id @default(cuid())
  policyNumber      String   @unique
  type              String
  provider          String
  status            String
  premium           Float
  premiumFrequency  String
  startDate         DateTime
  endDate           DateTime
  coverageAmount    Float
  clientId          String
  client            User     @relation("ClientPolicies", fields: [clientId], references: [id])
  agentId           String
  agent             User     @relation("AgentPolicies", fields: [agentId], references: [id])
  details           String
  createdAt         DateTime @default(now())
  lastUpdated       DateTime @updatedAt
  documents         Document[]

  @@index([clientId])
  @@index([agentId])
  @@index([type])
}

model Document {
  id            String    @id @default(cuid())
  name          String
  type          String
  mimeType      String
  size          Int
  storagePath   String?
  status        String    @default("pending")
  policyId      String?
  policy        Policy?   @relation(fields: [policyId], references: [id])
  clientId      String
  client        User      @relation("ClientDocuments", fields: [clientId], references: [id])
  uploadedById  String
  uploadedBy    User      @relation("UploaderDocuments", fields: [uploadedById], references: [id])
  tags          String    @default("[]")
  aiAnalysis    String?
  signatureData String?
  uploadDate    DateTime  @default(now())

  @@index([clientId])
  @@index([status])
}

model Report {
  id            String   @id @default(cuid())
  title         String
  type          String
  status        String   @default("ready")
  format        String   @default("pdf")
  filters       String?
  data          String   @default("{}")
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())

  @@index([type])
}

model RegulatoryReport {
  id         String    @id @default(cuid())
  type       String
  clientId   String
  client     User      @relation(fields: [clientId], references: [id])
  status     String    @default("pending")
  data       String    @default("{}")
  aiInsights String    @default("[]")
  fetchedAt  DateTime?
  analyzedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([clientId, type])
  @@index([clientId])
}

model Affiliate {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  agentId        String
  agent          User     @relation(fields: [agentId], references: [id])
  commissionRate Float
  referrals      Int      @default(0)
  earnings       Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model BankConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  bankName    String
  accountType String
  status      String   @default("connected")
  balance     Float?
  lastSync    DateTime @default(now())
  createdAt   DateTime @default(now())
}

model InvestmentPortfolio {
  id          String       @id @default(cuid())
  clientId    String       @unique
  client      User         @relation(fields: [clientId], references: [id])
  totalValue  Float        @default(0)
  lastUpdated DateTime     @updatedAt
  investments Investment[]
}

model Investment {
  id                String              @id @default(cuid())
  portfolioId       String
  portfolio         InvestmentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  name              String
  type              String
  value             Float
  quantity          Float
  purchasePrice     Float
  currentPrice      Float
  returns           Float
  returnsPercentage Float
}

model Recording {
  id            String   @id @default(cuid())
  type          String
  duration      Int
  storagePath   String?
  transcription String?
  relatedTo     String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  context   String      @default("general")
  createdAt DateTime    @default(now())
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  attachments    String?
  createdAt      DateTime       @default(now())
}

model MarketplaceProduct {
  id        String   @id @default(cuid())
  name      String
  provider  String
  category  String
  price     String
  rating    Float
  features  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  message   String
  icon      String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// CRM: customers/leads keyed on Israeli ID (תעודת זהות).
// Allows agents to bulk-upload prospects + customer details from CSV/JSON.
// All ancillary data (policies, communications, free notes, raw imported rows)
// reference the lead via idNumber so re-uploading the same person accumulates
// information instead of creating duplicates.
// -----------------------------------------------------------------------------

model Lead {
  id           String   @id @default(cuid())
  idNumber     String   @unique
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  altPhone     String?
  address      String?
  city         String?
  birthDate    DateTime?
  gender       String?
  source       String?
  status       String   @default("new") // new | contacted | qualified | customer | lost
  agentId      String?
  agencyId     String?
  metadata     String   @default("{}")  // JSON: free-form/extra columns from imports
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  policies       LeadPolicy[]
  communications LeadCommunication[]
  importRows     LeadImportRow[]

  @@index([agencyId])
  @@index([agentId])
  @@index([status])
}

model LeadPolicy {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  policyNumber String?
  type         String?
  provider     String?
  status       String?
  premium      Float?
  startDate    DateTime?
  endDate      DateTime?
  raw          String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([leadId])
}

model LeadCommunication {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel    String   // phone | email | whatsapp | sms | meeting | other
  direction  String   @default("outbound") // outbound | inbound
  summary    String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model CustomerImport {
  id           String   @id @default(cuid())
  fileName     String
  uploadedById String
  rowCount     Int      @default(0)
  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  errorCount   Int      @default(0)
  createdAt    DateTime @default(now())

  rows LeadImportRow[]

  @@index([uploadedById])
}

model LeadImportRow {
  id       String         @id @default(cuid())
  importId String
  import   CustomerImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?          @relation(fields: [leadId], references: [id])
  idNumber String?
  rowIndex Int
  status   String  // created | updated | skipped | error
  raw      String  // JSON of the original row
  error    String?

  @@index([importId])
  @@index([leadId])
}

// -----------------------------------------------------------------------------
// External landing-page submissions (e.g. real-estate / social-media campaigns).
// Public, no auth required to insert; agents+ can read and convert into CRM
// `Lead` records via the internal dashboard.
// -----------------------------------------------------------------------------

model RealEstateLead {
  id              String   @id @default(cuid())
  fullName        String
  phone           String
  email           String?
  preferredTime   String   // 'morning' | 'noon' | 'evening'
  notes           String?
  source          String?  // free-text source label (e.g. campaign name)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  referrer        String?
  ipAddress       String?
  userAgent       String?
  status          String   @default("new") // new | contacted | scheduled | qualified | converted | lost
  assignedAgentId String?
  convertedLeadId String?  // FK into Lead.id once an agent enriches with idNumber
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([email])
}
